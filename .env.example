# 可留空，改在本機網頁中臨時輸入；網頁輸入的金鑰不會寫入磁碟。
OPENAI_API_KEY=
GEMINI_API_KEY=

# 可依需求更換模型。
TRANSCRIPTION_MODEL=gpt-4o-transcribe
SUMMARY_MODEL=gpt-5.6-terra
SUMMARY_REASONING_EFFORT=low
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_COOLDOWN_SECONDS=600

# Gemini 免費層預設每 5 秒最多送出一個請求，保守避開每分鐘限制。
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=5.0

# 每個音訊片段的秒數；48 kbps MP3 在 900 秒時約 5.4 MB。
CHUNK_SECONDS=900

# 選配：只在你有權存取的影片上使用。請勿提交 Cookie 檔。
YTDLP_COOKIES_FILE=
