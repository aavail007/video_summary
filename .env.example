# 可留空，改在本機網頁中臨時輸入；網頁輸入的金鑰不會寫入磁碟。
OPENAI_API_KEY=
GEMINI_API_KEY=

# 可依需求更換模型。
TRANSCRIPTION_MODEL=gpt-4o-transcribe
SUMMARY_MODEL=gpt-5.6-terra
SUMMARY_REASONING_EFFORT=low
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_COOLDOWN_SECONDS=600

# Gemini 免費層預設每 5 秒最多送出一個請求，保守避開每分鐘限制。
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=5.0

# 單次 Gemini HTTP 請求逾時秒數；適用轉錄、摘要及投影片分析。
GEMINI_REQUEST_TIMEOUT_SECONDS=300
# 503、伺服器錯誤與網路逾時額外重試次數（0–5）；2 表示最多嘗試 3 次。
# SDK 內建重試會停用，避免重試次數疊加。
GEMINI_MAX_TRANSIENT_RETRIES=2

# 每個音訊片段的秒數；48 kbps MP3 在 900 秒時約 5.4 MB。
CHUNK_SECONDS=900

# 選配：只在你有權存取的影片上使用。請勿提交 Cookie 檔。
YTDLP_COOKIES_FILE=

# 本機網頁連接埠；若 7860 被其他程式占用可改為其他數字。
VIDEO_SUMMARY_PORT=7860
